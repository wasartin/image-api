# Copy to .env and adjust. `make start` loads it automatically.
# Defaults match photoDB/docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pi_frame_displayable
DB_USER=pg-user
DB_PASSWORD=docket
# Or set one full URL instead of the DB_* values:
# DATABASE_URL=postgresql+psycopg://pg-user:docket@127.0.0.1:5432/pi_frame_displayable

# Where uploaded photos are stored
IMAGE_DIR=./images
MAX_UPLOAD_MB=25
